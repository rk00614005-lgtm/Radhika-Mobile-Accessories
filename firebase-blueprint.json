{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Mobile accessory product in the Radhika Mobile Accessories catalogue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 5000 },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "categoryId": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "compatibleModels": { "type": "array" },
        "inStock": { "type": "boolean" },
        "stockQuantity": { "type": "number" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "images": { "type": "array" },
        "colors": { "type": "array" },
        "tags": { "type": "array" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "price", "categoryId"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category grouping",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 500 },
        "icon": { "type": "string", "maxLength": 50 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "displayOrder": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "userId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 20 },
        "shippingAddress": { "type": "object" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "shippingFee": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "orderStatus": { "type": "string", "maxLength": 50 },
        "fulfillmentType": { "type": "string", "maxLength": 50 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["orderNumber", "customerName", "customerPhone", "items", "total"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon voucher",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string", "maxLength": 30 },
        "discountType": { "type": "string", "maxLength": 20 },
        "discountValue": { "type": "number" },
        "minOrderValue": { "type": "number" },
        "maxDiscount": { "type": "number" },
        "validUntil": { "type": "string" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 250 }
      },
      "required": ["code", "discountType", "discountValue"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product rating and review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string", "maxLength": 100 },
        "userName": { "type": "string", "maxLength": 100 },
        "userId": { "type": "string", "maxLength": 128 },
        "rating": { "type": "number" },
        "title": { "type": "string", "maxLength": 200 },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["productId", "userName", "rating", "comment"]
    },
    "GalleryItem": {
      "title": "GalleryItem",
      "description": "Shop storefront or interior photograph metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 50 },
        "description": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "imageUrl"]
    },
    "ContactMessage": {
      "title": "ContactMessage",
      "description": "Contact message submitted by a customer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 4000 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email", "message"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Store administrator privilege registry",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "addedAt": { "type": "string" }
      },
      "required": ["email", "role"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 25 },
        "role": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of mobile accessories sold at Radhika Mobile Accessories"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories grouping cases, tempered glass, chargers, etc."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Store discount coupons"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product ratings and reviews"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Shop and product gallery photographs"
    },
    "/contact_messages/{messageId}": {
      "schema": "ContactMessage",
      "description": "Customer inquiries and contact messages"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Designated store admin UIDs"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Customer account profiles"
    }
  }
}
