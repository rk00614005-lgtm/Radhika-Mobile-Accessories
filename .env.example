# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Configuration
PORT=3000
NODE_ENV="development"

# PostgreSQL / Prisma Database URL (e.g. postgresql://user:password@localhost:5432/radhika_store?schema=public)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/radhika_mobile_accessories?schema=public"

# Authentication Secrets
JWT_SECRET="radhika-secret-jwt-key-change-in-production-2025"
ADMIN_KEY="admin-secret-access-token"

# Razorpay Test Mode Credentials (Get from dashboard.razorpay.com)
# TEST MODE ONLY: Use test key id starting with rzp_test_
RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayKeySecretHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
RAZORPAY_MERCHANT_NAME="Radhika Mobile Accessories"

# Cloudinary Free Tier Persistent Image Storage (Server-Side Secrets)
# Register at cloudinary.com (Free Tier: 25 GB managed storage & bandwidth)
# Cloudinary Dashboard -> Product Environment Settings -> API Keys
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Store Settings
SHOP_NAME="Radhika Mobile Accessories"
SHOP_PHONE_1="7207126270"
SHOP_PHONE_2="9492456210"
SHOP_EMAIL="rk00614005@gmail.com"
SHOP_ADDRESS="Market Road, Opposite to the Current Office, Bhadrachalam"
SHOP_HOURS="Open Daily: 9:00 AM – 10:00 PM"
COD_ENABLED="true"
FREE_SHIPPING_THRESHOLD=499
DEFAULT_SHIPPING_FEE=49
